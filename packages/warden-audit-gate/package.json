{
  "name": "@warden/audit-gate",
  "version": "0.1.0",
  "description": "Local-first audit target admission gate for Warden",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build-check": "tsc --noEmit -p ./tsconfig.test.json",
    "start": "tsx src/server.ts",
    "start:target": "tsx src/demo-target.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
